<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" name-as-sort-order="all" sort-separator=" " demote-non-dropping-particle="never" initialize-with=" " initialize-with-hyphen="false" page-range-format="minimal" default-locale="zh-CN">
  <info>
    <title>China National Standard GB/T 7714-2015 (numeric, 中文，SUES硕士毕业论文格式)</title>
    <id>http://www.zotero.org/styles/china-national-standard-gb-t-7714-2015-numeric</id>
    <link href="http://www.zotero.org/styles/china-national-standard-gb-t-7714-2015-numeric" rel="self"/>
    <link href="https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D8055ED3A7E05397BE0A0AB82A" rel="documentation"/>
    <author>
      <name>牛耕田</name>
      <email>buffalo_d@163.com</email>
    </author>
    <contributor>
      <name>Zeping Lee</name>
      <email>zepinglee@gmail.com</email>
    </contributor>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>The Chinese GB/T 7714-2015 numeric style, customized journal format</summary>
    <updated>2024-09-18T20:42:19+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="zh">
    <date form="text">
      <date-part name="year" suffix="年" range-delimiter="&#8212;"/>
      <!-- <date-part name="month" form="numeric" suffix="月" range-delimiter="&#8212;"/> -->
      <!-- <date-part name="day" suffix="日" range-delimiter="&#8212;"/> -->
    </date>
    <terms>
      <term name="edition" form="short">版</term>
      <term name="open-quote">"</term>
      <term name="close-quote">"</term>
      <term name="open-inner-quote">'</term>
      <term name="close-inner-quote">'</term>
      <term name="et-al">等</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <locale xml:lang="en">
    <date form="numeric">
      <date-part name="year" range-delimiter="/"/>
      <!-- <date-part name="month" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/> -->
      <!-- <date-part name="day" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/> -->
    </date>
    <terms>
      <term name="page-range-delimiter">-</term>
      <term name="et-al">et al.</term>
    </terms>
  </locale>

  <!-- 主要责任者：姓名完整显示，姓在前名在后，逗号分隔，超3位加"等"或"et al" -->
  <macro name="author">
    <names variable="author">
      <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
      <et-al term="et-al"/>
      <substitute>
        <names variable="composer"/>
        <names variable="illustrator"/>
        <names variable="director"/>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor">
              <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
              <et-al term="et-al"/>
            </names>
          </if>
        </choose>
      </substitute>
    </names>
  </macro>

  <!-- 文献类型标识 -->
  <macro name="type-id">
    <choose>
      <if type="article bill collection hearing legal_case legislation personal_communication regulation treaty" match="any">
        <text value="A"/>
      </if>
      <else-if type="article-journal article-magazine periodical" match="any">
        <text value="J"/>
      </else-if>
      <else-if type="article-newspaper">
        <text value="N"/>
      </else-if>
      <else-if type="book chapter classic entry-dictionary entry-encyclopedia" match="any">
        <text value="M"/>
      </else-if>
      <else-if type="dataset">
        <text value="DS"/>
      </else-if>
      <else-if type="map">
        <text value="CM"/>
      </else-if>
      <else-if type="paper-conference">
        <text value="C"/>
      </else-if>
      <else-if type="patent">
        <text value="P"/>
      </else-if>
      <else-if type="post post-weblog webpage" match="any">
        <text value="EB"/>
      </else-if>
      <else-if type="report">
        <text value="R"/>
      </else-if>
      <else-if type="software">
        <text value="CP"/>
      </else-if>
      <else-if type="standard">
        <text value="S"/>
      </else-if>
      <else-if type="thesis">
        <text value="D"/>
      </else-if>
      <else>
        <text value="Z"/>
      </else>
    </choose>
  </macro>

  <!-- 文献载体标识 -->
  <macro name="medium-id">
    <choose>
      <if variable="medium">
        <text variable="medium"/>
      </if>
    </choose>
  </macro>

  <!-- 专著题名：题名:版本[M] -->
  <macro name="title-book">
    <group delimiter=": ">
      <text variable="title"/>
      <text macro="edition"/>
    </group>
    <text value="[M]"/>
  </macro>

  <!-- 题名（含文献类型标识） -->
  <macro name="title">
    <group delimiter=": ">
      <text variable="title"/>
    </group>
    <group delimiter="/" prefix="[" suffix="]">
      <text macro="type-id"/>
      <text macro="medium-id"/>
    </group>
  </macro>

  <!-- 专利题名：题名:专利号[P] -->
  <macro name="title-patent">
    <group delimiter=": ">
      <text variable="title"/>
      <text variable="number"/>
    </group>
    <text value="[P]"/>
  </macro>

  <!-- 技术标准题名：标准名称:标准代号[S] -->
  <macro name="title-standard">
    <group delimiter=": ">
      <text variable="title"/>
      <text variable="number"/>
    </group>
    <text value="[S]"/>
  </macro>

  <!-- 其他责任者（译者） -->
  <macro name="secondary-contributors">
    <names variable="translator">
      <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
      <et-al term="et-al"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <!-- 论文集/专著主要责任者（主编） -->
  <macro name="container-contributors">
    <names variable="editor">
      <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
      <et-al term="et-al"/>
      <substitute>
        <names variable="editorial-director">
          <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
          <et-al term="et-al"/>
        </names>
        <names variable="collection-editor">
          <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
          <et-al term="et-al"/>
        </names>
        <names variable="container-author">
          <name delimiter=", " name-as-sort-order="all" sort-separator=" "/>
          <et-al term="et-al"/>
        </names>
      </substitute>
    </names>
  </macro>

  <!-- 版本项：第1版不标注 -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <choose>
          <!-- 第1版不标注 -->
          <if variable="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <label variable="edition" form="short"/>
            </group>
          </if>
        </choose>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- 出版年 -->
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued" form="numeric" date-parts="year"/>
      </if>
      <else-if type="article-journal" variable="available-date" match="all">
        <date variable="available-date" form="numeric" date-parts="year"/>
      </else-if>
      <else>
        <date variable="accessed" form="numeric" date-parts="year"/>
      </else>
    </choose>
  </macro>

  <!-- 学位论文出版年（仅用已发布的issued，不用accessed） -->
  <macro name="issued-year-thesis">
    <choose>
      <if variable="issued">
        <date variable="issued" form="numeric" date-parts="year"/>
      </if>
    </choose>
  </macro>

  <!-- 出版日期（报纸、专利公告日期） -->
  <macro name="issued-date">
    <date variable="issued" form="numeric"/>
  </macro>

  <!-- 学位论文出版项：出版地:出版者,出版年:起止页码 -->
  <macro name="publisher-thesis">
    <choose>
      <if variable="publisher publisher-place">
        <group delimiter=", ">
          <group delimiter=": ">
            <choose>
              <if variable="publisher-place">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </if>
              <else>
                <text variable="publisher"/>
              </else>
            </choose>
          </group>
          <text macro="issued-year-thesis"/>
        </group>
      </if>
      <else>
        <text macro="issued-year-thesis"/>
      </else>
    </choose>
    <choose>
      <if variable="page">
        <text variable="page" prefix=": "/>
      </if>
    </choose>
  </macro>

  <!-- 出版项：出版地:出版者,出版年:起止页码 -->
  <macro name="publisher">
    <choose>
      <if type="patent">
        <!-- 专利：只显示公告日期 -->
        <text macro="issued-date"/>
      </if>
      <else-if type="standard">
        <!-- 技术标准：出版地:出版者,出版年:起止页码 -->
        <group delimiter=": ">
          <group delimiter=", ">
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <text macro="issued-year"/>
          </group>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="legislation bill hearing regulation treaty" match="any">
        <group delimiter=". ">
          <text variable="publisher"/>
          <text macro="issued-date"/>
        </group>
      </else-if>
      <else-if type="book chapter paper-conference periodical thesis" variable="archive archive-place publisher publisher-place page" match="any">
        <!-- 出版地:出版者,出版年:起止页码 -->
        <group delimiter=": ">
          <group delimiter=", ">
            <group delimiter=": ">
              <choose>
                <if variable="publisher publisher-place" match="any">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </if>
                <else>
                  <text variable="archive-place"/>
                  <text variable="archive"/>
                </else>
              </choose>
            </group>
            <text macro="issued-year"/>
          </group>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if variable="URL DOI" match="any">
        <text macro="issued-date"/>
      </else-if>
      <else>
        <text macro="issued-year"/>
      </else>
    </choose>
  </macro>

  <!-- 期刊出处项：刊名,出版年份,卷(期):起止页码 -->
  <macro name="container-periodical">
    <choose>
      <if type="article-newspaper">
        <!-- 报纸：刊名,出版日期(版次) -->
        <group delimiter=", ">
          <text variable="container-title"/>
          <text macro="issued-date"/>
        </group>
        <text variable="page" prefix="(" suffix=")"/>
      </if>
      <else>
        <!-- 期刊：刊名,出版年份,卷(期):起止页码 -->
        <group delimiter=": ">
          <group>
            <group delimiter=", ">
              <text variable="container-title"/>
              <text macro="issued-year"/>
              <text variable="volume"/>
            </group>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- 专著容器题名 -->
  <macro name="container-booklike">
    <choose>
      <if type="paper-conference">
        <group delimiter=", ">
          <text variable="event-title"/>
          <text variable="event-place"/>
        </group>
      </if>
      <else-if variable="container-title">
        <!-- <group delimiter=": "> -->
          <text variable="container-title"/>
        <!-- </group> -->
      </else-if>
    </choose>
  </macro>

  <!-- 获取和访问路径 -->
  <macro name="access">
    <group delimiter=". ">
      <text variable="URL"/>
      <text variable="DOI" prefix="DOI:"/>
    </group>
  </macro>

  <!-- 参考文献表格式 -->
  <macro name="entry-layout">
    <choose>

      <!-- （1）期刊：作者.题名[J].刊名,出版年份,卷(期):起止页码 -->
      <if type="article-journal article-magazine" match="any">
        <group delimiter=". ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="container-periodical"/>
        </group>
      </if>

      <!-- 报纸 -->
      <else-if type="article-newspaper">
        <group delimiter=". ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="container-periodical"/>
        </group>
      </else-if>

      <!-- （5）专利：申请者.题名:专利号[P].公告日期 -->
      <else-if type="patent">
        <group delimiter=". ">
          <text macro="author"/>
          <text macro="title-patent"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- （6）技术标准：起草者.标准名称:标准代号[S].出版地:出版者,年:页码 -->
      <else-if type="standard">
        <group delimiter=".">
          <text macro="author"/>
          <text macro="title-standard"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- 电子资源 -->
      <else-if type="dataset post post-weblog software webpage" match="any">
        <group delimiter=".">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- （3）论文集：主编.论文集名[C].出版地:出版者,出版年:起止页码 -->
      <else-if type="paper-conference">
        <group delimiter=". ">
          <text macro="container-contributors"/>
          <group delimiter="">
            <choose>
              <if variable="container-title">
                <text variable="container-title"/>
              </if>
              <else-if variable="event-title">
                <text variable="event-title"/>
              </else-if>
              <else>
                <text variable="title"/>
              </else>
            </choose>
            <text value="[C]"/>
          </group>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- 专著中的析出文献（含论文集中析出） -->
      <else-if type="chapter entry-dictionary entry-encyclopedia" variable="container-title" match="any">
        <group delimiter=".">
          <text macro="author"/>
          <group delimiter="//">
            <group delimiter=".">
              <text macro="title"/>
              <text macro="secondary-contributors"/>
            </group>
            <group delimiter=".">
              <text macro="container-contributors"/>
              <text macro="container-booklike"/>
            </group>
          </group>
          <text macro="edition"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- （4）学位论文：作者.题名[D].出版地:出版者,出版年:起止页码 -->
      <else-if type="thesis">
        <group delimiter=".">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="publisher-thesis"/>
        <group delimiter=": ">
          <text macro="publisher-place"/>
        </group>
          <text variable="page"/>
        </group>
      </else-if>

      <!-- 政府公文 -->
      <else-if type="legislation bill hearing regulation treaty" match="any">
        <group delimiter=".">
          <text macro="title"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- 连续出版物 -->
      <else-if type="periodical">
        <group delimiter=".">
          <text macro="author"/>
          <text macro="title"/>
          <group delimiter=", ">
            <text macro="issued-year"/>
            <text variable="volume"/>
          </group>
          <text variable="issue" prefix="(" suffix=")"/>
          <text macro="publisher"/>
        </group>
      </else-if>

      <!-- （2）专著：作者.书名:版本[M].出版地:出版者,出版年:起止页码 -->
      <else>
        <group delimiter=".">
          <text macro="author"/>
          <text macro="title-book"/>
          <text macro="secondary-contributors"/>
          <text macro="publisher"/>
        </group>
      </else>

    </choose>
  </macro>

  <!-- 正文引用格式：上角标，方括号，连续编号合并 -->
  <citation collapse="citation-number" after-collapse-delimiter=",">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter="," prefix="[" suffix="]">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- 参考文献表 -->
  <bibliography entry-spacing="0" et-al-min="4" et-al-use-first="3" second-field-align="flush" hanging-indent="false">
    <layout suffix="." locale="en">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry-layout"/>
    </layout>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry-layout"/>
    </layout>
  </bibliography>
</style>
